    ],
    "kind": "admin",
    "max_rows_per_write": 1000,
    "tables": null
   },
   "read_only": {
    "allow_functions": [],
    "kind": "read_only",
    "max_rows_per_write": 10,
    "tables": {
     "accounts": {
      "delete": false,
      "insert": false,
      "read": "*",
      "update": []
     },
     "orders": {
      "delete": false,
      "insert": false,
      "read": "*",
      "update": []
     }
    }
   },
   "scoped_write": {
    "allow_functions": [],
    "kind": "scoped_write",
    "max_rows_per_write": 10,
    "tables": {
     "accounts": {
      "delete": false,
      "insert": true,
      "read": "*",
      "update": [
       "balance",
       "owner"
      ]
     },
     "orders": {
      "delete": true,
      "insert": true,
      "read": "*",
      "update": [
       "status",
       "amount"
      ]
     }
    }
   }
  },
  "version": 1,
  "version_column": "version"
